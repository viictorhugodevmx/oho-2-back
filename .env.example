NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/oho_2_local
FRONTEND_URL=http://localhost:3000

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
ACCESS_COOKIE_NAME=oho_access
REFRESH_COOKIE_NAME=oho_refresh
BCRYPT_ROUNDS=12

QUOTE_TTL_MINUTES=15
GUEST_ACCESS_TTL_HOURS=72
SHIPPING_PRICE_CENTS=14900
FREE_SHIPPING_MINIMUM_CENTS=150000

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=OHO 2.0 <no-reply@oho20.local>

LOG_LEVEL=debug
